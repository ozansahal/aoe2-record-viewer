{
  "name": "aoe2-record-viewer",
  "version": "0.1.0",
  "description": "Scrub an Age of Empires II: DE recording and see what each player built, researched and trained.",
  "license": "MIT",
  "author": "Ozan Şahal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozansahal/aoe2-record-viewer.git"
  },
  "homepage": "https://ozansahal.github.io/aoe2-record-viewer/",
  "bugs": "https://github.com/ozansahal/aoe2-record-viewer/issues",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "build:web": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder",
    "parse": "node cli/parse_rec.js",
    "events": "node cli/filter_events.js",
    "package:portable": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  },
  "build": {
    "appId": "dev.aoe2.record-viewer",
    "productName": "AoE2 Record Viewer",
    "files": [
      "dist/**",
      "dist-electron/**",
      "assets/icon.png"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "fileAssociations": [
      {
        "ext": "aoe2record",
        "name": "Age of Empires II recorded game",
        "role": "Viewer"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
